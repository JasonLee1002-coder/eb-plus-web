{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "eb-plus-web.vercel.app" }],
      "destination": "https://cptfm.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.cptfm.com" }],
      "destination": "https://cptfm.com/:path",
      "permanent": true
    }
  ]
}
